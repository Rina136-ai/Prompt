# Copy to .env and fill in to enable real generation via Higgsfield.
# Without this, the app runs fully offline using the mock generator and the
# UI shows "MODE DEMO" everywhere.
#
# Format verified against the official @higgsfield/client npm SDK (v2):
# Authorization: Key <KEY_ID>:<KEY_SECRET> against https://platform.higgsfield.ai
HIGGSFIELD_CREDENTIALS=
# Or, equivalently, as two separate variables:
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# DoP (image-to-video) model tier: dop-lite (default, cheapest/basic),
# dop-turbo (2x speed, priority queue), or dop-standard (highest quality,
# priority queue). Leave unset to use the cheapest tier (dop-lite).
# HIGGSFIELD_VIDEO_MODEL=dop-lite

# Set to 1 to actually run tests/integration/test_higgsfield_live.py (spends credits).
RUN_LIVE_GENERATION_TESTS=0
